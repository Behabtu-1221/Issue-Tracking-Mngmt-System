# ==============================================================================
# Enterprise Issue Tracking & Service Request Management System (ITMS)
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the BackEnd directory and configure with strong values.
# NEVER commit the actual .env file or real secrets to source control.
# ==============================================================================

# Server Environment
# Options: development, production, test
NODE_ENV=development

# Server Network Binding (0.0.0.0 allows connections from local Wi-Fi / LAN devices)
HOST=0.0.0.0
PORT=5000

# ==============================================================================
# Database Configuration (MySQL 8.0+)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=itms_user
DB_PASSWORD=your_strong_database_password_here
DB_NAME=issue_tracking_system
DB_CONNECTION_LIMIT=10

# ==============================================================================
# Cryptographic & Authentication Secrets
# ==============================================================================
# Generate secure 64-byte random keys: openssl rand -base64 48
# In production, values shorter than 32 characters or default strings will abort startup.
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_at_least_32_chars_long

# Token Lifespans
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# CORS & Web Client Settings
# ==============================================================================
# Comma-separated list of allowed browser origins (NEVER use wildcard * in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Base URL (used in email links, password reset URLs, and redirections)
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Rate Limiting
# ==============================================================================
# Global IP limit (window in ms, max requests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Authentication endpoint limit (login & refresh: window in ms, max attempts)
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Password reset limit (window in ms, max attempts per IP)
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX=5

# ==============================================================================
# Email & SMTP Credentials (Notification & Password Reset)
# ==============================================================================
# Service name (e.g. gmail) or custom SMTP host
SMTP_SERVICE=
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM="Enterprise ITMS Service Desk" <noreply@enterprise-itms.com>

# ==============================================================================
# Logging
# ==============================================================================
# Options: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info
