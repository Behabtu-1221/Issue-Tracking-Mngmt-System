# ==============================================================================
# Enterprise Issue Tracking & Service Request Management System (ITMS)
# Root Environment Template
# ==============================================================================
# Copy this file to BackEnd/.env and configure your local settings.
# See BackEnd/.env.example for comprehensive field descriptions.
# ==============================================================================

NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=issue_tracking_system

JWT_SECRET=generate_using_openssl_rand_base64_48_min_32_characters
JWT_REFRESH_SECRET=generate_using_openssl_rand_base64_48_min_32_characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

CORS_ALLOWED_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
PASSWORD_RESET_RATE_LIMIT_MAX=5

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false
SMTP_FROM="Enterprise ITMS" <noreply@enterprise.com>
LOG_LEVEL=info
